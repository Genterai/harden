{
  "name": "harden",
  "description": "Hardens change requests into briefs before code, and keeps a product's red lines and their tests in step: the hardening-changes skill, the harden check, and genter-cli to find what exists by meaning.",
  "version": "0.2.0",
  "author": {
    "name": "Genterai",
    "url": "https://github.com/Genterai"
  },
  "homepage": "https://github.com/Genterai/harden",
  "repository": "https://github.com/Genterai/harden",
  "license": "Apache-2.0",
  "keywords": [
    "requirements",
    "specs",
    "change-requests",
    "red-lines",
    "agents",
    "skills"
  ],
  "mcpServers": {
    "genter": {
      "command": "npx",
      "args": [
        "-y",
        "genter-cli@0.3",
        "mcp"
      ],
      "env": {
        "GENTER_SEMANTIC": "${GENTER_SEMANTIC:-}",
        "OPENAI_API_KEY": "${OPENAI_API_KEY:-}",
        "OPENROUTER_API_KEY": "${OPENROUTER_API_KEY:-}",
        "AI_GATEWAY_API_KEY": "${AI_GATEWAY_API_KEY:-}",
        "GENTER_TOKEN": "${GENTER_TOKEN:-}"
      }
    }
  }
}
